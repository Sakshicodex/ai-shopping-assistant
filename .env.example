# Groq (FREE - get key at console.groq.com)
GROQ_API_KEY=your_groq_api_key

# Tabbly.io (AI Voice Calls - sign up at tabbly.io)
TABBLY_API_KEY=your_tabbly_api_key
TABBLY_ORG_ID=your_tabbly_org_id
TABBLY_AGENT_ID=your_tabbly_agent_id
TABBLY_PHONE_NUMBER=your_tabbly_phone_number

# Client-side (in client/.env)
# REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
# REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# REACT_APP_FIREBASE_PROJECT_ID=your_project_id
# REACT_APP_FIREBASE_APP_ID=your_firebase_app_id

PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3001
